# Copy this file to .env and fill in your keys:  cp env.example .env
# .env is git-ignored. Environment variables already set in your shell take precedence.

# --- TMDB (required) -------------------------------------------------------
# Create a free key at https://www.themoviedb.org/settings/api
# Use EITHER the v4 "API Read Access Token" (recommended; starts with "eyJ...")
# OR the v3 API key.
TMDB_BEARER=
# TMDB_API_KEY=

# --- Mistral (optional) ----------------------------------------------------
# Only needed with the `--llm` flag, as a fallback for titles that watch-order
# inference cannot place. Get a key at https://console.mistral.ai
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
